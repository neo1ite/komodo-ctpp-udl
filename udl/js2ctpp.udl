family csl

state IN_CSL_SSTRING:
  /<\/?(?i:TMPL_(?:var|if|elsif|else|unless|loop|foreach|udf|include|comment|block|call))\b/ : \
    paint(upto, CSL_STRING), \
    paint(include, TPL_OPERATOR), \
    spush_check(IN_CSL_SSTRING), => IN_TPL_DEFAULT

state IN_CSL_DSTRING:
  /<\/?(?i:TMPL_(?:var|if|elsif|else|unless|loop|foreach|udf|include|comment|block|call))\b/ : \
    paint(upto, CSL_STRING), \
    paint(include, TPL_OPERATOR), \
    spush_check(IN_CSL_DSTRING), => IN_TPL_DEFAULT
