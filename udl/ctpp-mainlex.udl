# Переходники. Специальные CTPP-переходы должны идти раньше штатных
# HTML->JavaScript переходов.
include "html2ctpp.udl"
include "htmljs2ctpp.udl"
include "html2underscore.udl"
include "html2js.udl"
include "html2css.udl"
include "css2html.udl"
include "js2html.udl"
include "js2ctpp.udl"
include "js2underscore.udl"
include "underscore2js.udl"

language CTPP

# Базовые лексеры
include "html.udl"
include "csslex.udl"
include "jslex.udl"

# CTPP (template family) + Underscore (client-side family like JS)
include "utjslex.udl"
include "ctpplex.udl"
