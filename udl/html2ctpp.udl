family markup

# В CTPP2 теги case-insensitive, поэтому используем (?i:...)
# Список тегов: var/if/elsif/else/unless/loop/foreach/udf/include/comment/block/call
# (см. CTPP2 tags) :contentReference[oaicite:5]{index=5}
state IN_M_DEFAULT:
  /<\/?(?i:TMPL_(?:var|if|elsif|else|unless|loop|foreach|udf|include|comment|block|call))\b/ : \
    paint(upto, M_DEFAULT), \
    paint(include, TPL_OPERATOR), \
    spush_check(IN_M_DEFAULT), => IN_TPL_DEFAULT

  /<!--\s*(?i:TMPL_(?:var|if|elsif|else|unless|loop|foreach|udf|include|comment|block|call))\b/ : \
    paint(upto, M_DEFAULT), \
    paint(include, TPL_COMMENT), \
    spush_check(IN_M_DEFAULT), => IN_TPL_CTPP_HTML_COMMENT

state IN_M_STAG_ATTR_DSTRING:
  /<\/?(?i:TMPL_(?:var|if|elsif|else|unless|loop|foreach|udf|include|comment|block|call))\b/ : \
    paint(upto, M_STRING), \
    paint(include, TPL_OPERATOR), \
    spush_check(IN_M_STAG_ATTR_DSTRING), => IN_TPL_DEFAULT

state IN_M_STAG_ATTR_SSTRING:
  /<\/?(?i:TMPL_(?:var|if|elsif|else|unless|loop|foreach|udf|include|comment|block|call))\b/ : \
    paint(upto, M_STRING), \
    paint(include, TPL_OPERATOR), \
    spush_check(IN_M_STAG_ATTR_SSTRING), => IN_TPL_DEFAULT

state IN_M_STAG_ATTR_USTRING:
  /<\/?(?i:TMPL_(?:var|if|elsif|else|unless|loop|foreach|udf|include|comment|block|call))\b/ : \
    paint(upto, M_STRING), \
    paint(include, TPL_OPERATOR), \
    spush_check(IN_M_STAG_ATTR_USTRING), => IN_TPL_DEFAULT
